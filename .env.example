# 复制为 .env 使用（gitignore）。compose 会自动加载 .env 做变量插值，
# 并经 env_file 注入 web/worker/beat 容器（容器内 DB_HOST/REDIS_URL 被 compose 显式覆盖）。
# 本地 venv 直接跑 pytest 时用这里的值（DB_HOST=localhost）。

SECRET_KEY=dev-insecure-secret-key
DEBUG=1
FRONTEND_ORIGIN=http://localhost

DB_NAME=recon
DB_USER=recon
DB_PASSWORD=recon
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# SSO / OIDC（默认关；企业 IdP 参数在此配置，代码不写死）
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_MAP={}

# 邮件告警（默认 console 后端，开发期打印到日志）
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_FROM=recon@local
ALERT_EMAIL_TO=
